# MongoDB Atlas connection string.
# Get this from Atlas -> Database -> Connect -> Drivers, then fill in your
# username/password and add a database name before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/horeca-jaya?retryWrites=true&w=majority

# Secret key used to sign login session cookies (JWT). Generate one with
# `openssl rand -base64 32` (or any long random string) and keep it secret —
# anyone with this value could forge a valid session. Required in production;
# falls back to an insecure dev-only default if unset locally.
SESSION_SECRET=

# Vercel Blob storage token — used by /api/upload (product photos, payment
# proof, kwitansi, komisi bukti transfer, RAB/denah attachments) instead of
# writing to public/uploads/ (Vercel's filesystem isn't writable/persistent
# in production). Named Hojay_READ_WRITE_TOKEN (not the SDK's default
# BLOB_READ_WRITE_TOKEN) because that's what the Blob store's own "Connect
# Project" flow auto-generated for this project — get the value from the
# Vercel dashboard: Project -> Storage -> the Blob store -> .env.local tab.
# On Vercel itself this is filled in automatically once the store is
# attached to the project; only needs setting here for `npm run dev` too.
Hojay_READ_WRITE_TOKEN=
Hojay_STORE_ID=
