# MongoDB Atlas connection string.
# Get this from Atlas -> Database -> Connect -> Drivers, then fill in your
# username/password and add a database name before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/horeca-jaya?retryWrites=true&w=majority

# Vercel Blob storage token — used by /api/upload (product photos, payment
# proof) instead of writing to public/uploads/ (Vercel's filesystem isn't
# writable/persistent in production). Get this from the Vercel dashboard:
# Project -> Storage -> create/select a Blob store -> .env.local tab.
# Only needed locally if you want uploads to work in `npm run dev` too —
# on Vercel itself this is filled in automatically once a Blob store is
# attached to the project.
BLOB_READ_WRITE_TOKEN=
